<?xml version="1.0"?>
<robot name="kitti">
  <link name="imu_link"/>
  <link name="velodyne"/>
  <link name="imu"/>
  <joint name="imu_link_to_velodyne" type="fixed">
    <parent link="imu_link"/>
    <child link="velodyne"/>
    <origin xyz="0.8086759 -0.3195559 0.7997231" rpy="-0.0020358 -0.0010176 0.0007553"/>
  </joint>
  <joint name="imu_link_to_imu" type="fixed">
    <parent link="imu_link"/>
    <child link="imu"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
